{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KWork",
  "mainBinaryName": "KWork",
  "version": "0.1.0",
  "identifier": "com.kense-labs.dsh-gpui",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KWork",
        "width": 600,
        "height": 700,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' data:; frame-src 'self' dsh-preview: http://dsh-preview.localhost",
      "capabilities": [
        {
          "identifier": "main-events",
          "webviews": ["main"],
          "permissions": ["core:event:allow-listen"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
