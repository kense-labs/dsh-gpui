{
  "name": "dsh-gpui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ui:build": "bun scripts/build-ui.mjs",
    "dev": "bun run ui:build && tauri dev",
    "build": "bun run ui:build && tauri build --no-bundle",
    "test:js": "bun test scripts/*.test.mjs",
    "check": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "dependencies": {
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "dompurify": "3.4.16",
    "harfbuzzjs": "1.6.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "esbuild": "0.28.2"
  }
}
